# CODE NAME — environment template.
# Copy this file to ".env" and fill in real values, then restart the app.
#
# IMPORTANT: the frontend can only read variables that start with VITE_
# (that is how Vite exposes them to the app). So a Gemini key MUST be named
# VITE_GEMINI_API_KEY — a plain GEMINI_API_KEY will NOT reach the app.

# Gemini (cloud) API key. Only needed if you use the "Gemini (cloud)" endpoint.
VITE_GEMINI_API_KEY="your-gemini-api-key"

# Ollama Cloud API key. Only needed for the "Ollama Cloud" (direct) endpoint.
# Create one at https://ollama.com (account settings -> API keys).
VITE_OLLAMA_API_KEY="your-ollama-api-key"
