{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CODE NAME",
  "version": "0.1.0",
  "identifier": "com.codename.harness",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CODE NAME: |",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "theme": "Dark",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "CODE NAME",
    "copyright": "Copyright © 2026 CODE NAME",
    "category": "Productivity",
    "shortDescription": "Local-first agent harness with a governed knowledge graph.",
    "longDescription": "CODE NAME is a local-first desktop agent harness: a two-pane governed workspace over a local knowledge ecosystem with a knowledge graph and SQLite KB retrieval, a model-agnostic execution canvas, hard capability gates, and a tamper-evident audit ledger. Runs fully offline by default; cloud models are optional and opt-in.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../sidecar/agent_sidecar.py": "sidecar/agent_sidecar.py"
    }
  }
}
